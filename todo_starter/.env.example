# Load with: uv run --env-file .env python manage.py runserver
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True
# Local SQLite is automatic. Production: use PostgreSQL, a shared Redis cache,
# a unique Django secret, a non-default admin URL, HTTPS, and working SMTP.
# DATABASE_URL=postgres://user:password@localhost:5432/todo_starter
# REDIS_URL=redis://localhost:6379/0
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=your-domain.com
# DJANGO_ADMIN_URL=your-private-admin-path/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/integrations/google/callback/
# Generate once: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
GOOGLE_TOKEN_ENCRYPTION_KEY=
